# Copy to .env (gitignored) and fill in. Never commit real values.

# Astra = Azure OpenAI resource, Responses API
APPMOD_ASTRA_ENDPOINT=https://<resource>.openai.azure.com
APPMOD_ASTRA_API_VERSION=2025-04-01-preview
APPMOD_ASTRA_API_KEY=
APPMOD_ASTRA_DEPLOYMENT=gpt-6-astra
APPMOD_ASTRA_MODEL_VERSION=2026-09-03

# Model tiers (deployment names on the same resource)
APPMOD_TIER_CODING=gpt-5.3-codex-PlayWright
APPMOD_TIER_FAST=gpt-4.1-mini
APPMOD_TIER_FALLBACK=gpt-5.4
APPMOD_TIER_EMBEDDING=text-embedding-ada-002

# auto | off      (off forces the deterministic runners)
APPMOD_LLM_MODE=auto
# off | read | record | replay
APPMOD_LLM_CACHE=read

# API auth: token=user:role1,role2;...  roles: operator, reviewer:portfolio,
# reviewer:architecture, reviewer:release, stakeholder, admin
APPMOD_AUTH_MODE=token
APPMOD_API_TOKENS=
# Allowed local repo roots (os.pathsep separated) and git hosts
APPMOD_REPO_ROOTS=
APPMOD_GIT_HOSTS=github.com,gitlab.com
